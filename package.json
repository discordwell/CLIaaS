{
  "name": "cliaas",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "cliaas": "./cli/dist/index.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:cli": "tsx cli/index.ts --help > /dev/null",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "cliaas": "tsx cli/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d && sleep 3 && pnpm db:migrate && pnpm db:seed",
    "db:setup": "bash scripts/db-setup.sh",
    "export:routes": "bash scripts/export_routes.sh",
    "bundle:submission": "bash scripts/make_submission_zip.sh",
    "extract-assets": "tsx scripts/extract-ra-assets.ts",
    "extract-tiles": "tsx scripts/extract-ra-tiles.ts",
    "extract-ant-originals": "bash scripts/extract-freeware-ant-originals.sh",
    "wet:campaign": "tsx scripts/run-ts-campaign-wet-test.ts",
    "parity:source": "tsx scripts/report-ra-source-parity.ts",
    "parity:agent": "tsx scripts/report-ra-agent-parity.ts",
    "parity:allied-missions": "tsx scripts/report-ra-allied-mission-agents.ts --strict",
    "parity:campaign-missions": "tsx scripts/report-ra-campaign-mission-agents.ts --strict",
    "parity:campaign-start-state": "tsx scripts/report-ra-campaign-start-state.ts --strict",
    "parity:campaign-trigger-spawns": "tsx scripts/report-ra-campaign-trigger-spawns.ts --strict",
    "runtime:closure": "tsx scripts/run-ra-runtime-closure.ts",
    "mcp:dev": "tsx cli/mcp/server.ts",
    "mcp:test": "pnpm cliaas mcp test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run src/EasterEgg/__tests__/dual-runtime-*.test.ts",
    "test:parity:fast": "SCENARIOS=SCG04EA,SCG07EA,SCG11EA MAX=30 BASE_URL=https://cliaas.com playwright test scripts/test-first-divergence.ts --reporter=list",
    "test:parity:full": "SCENARIOS=SCG01EA,SCG03EA,SCG04EA,SCG06EA,SCG07EA,SCG11EA,SCG13EA MAX=300 BASE_URL=https://cliaas.com playwright test scripts/test-first-divergence.ts --reporter=list",
    "test:parity:catalog": "MAX=100 BASE_URL=https://cliaas.com OUT=artifacts/divergence-catalog.json playwright test scripts/test-build-divergence-catalog.ts --reporter=list",
    "test:parity:golden": "tsx scripts/diff-divergence-catalog.ts",
    "test:parity:nightly": "vitest run src/EasterEgg/__tests__/dual-runtime-m8-comparison.test.ts",
    "test:db": "DATABASE_URL=${DATABASE_URL_TEST:-postgresql://cliaas:cliaas@localhost:5433/cliaas_test} vitest run src/__tests__/db-integration",
    "test:qa": "playwright test",
    "compare": "playwright test scripts/test-compare.ts && tsx scripts/generate-comparison-report.ts",
    "compare:report": "tsx scripts/generate-comparison-report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@sentry/nextjs": "^10.39.0",
    "@xyflow/react": "^12.10.1",
    "bullmq": "^5.70.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dagre": "^0.8.5",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.44.7",
    "fast-xml-parser": "^5.3.7",
    "ioredis": "^5.9.3",
    "jose": "^6.1.3",
    "lucide-react": "^0.577.0",
    "next": "16.2.0",
    "nodemailer": "^8.0.1",
    "openai": "^6.22.0",
    "ora": "^9.3.0",
    "pg": "^8.18.0",
    "pgvector": "^0.2.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.7.0",
    "stripe": "^20.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.16.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "jsdom": "^28.1.0",
    "pino-pretty": "^13.1.3",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  }
}
